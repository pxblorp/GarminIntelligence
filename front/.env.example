# Database Configuration (Turso/LibSQL)
# For persistent storage, configure a Turso database:
# 1. Create a free account at https://turso.tech
# 2. Create a database and get your connection URL and auth token
# 3. Set these environment variables in Vercel

# Turso Database URL (e.g., libsql://your-db-name.turso.io)
TURSO_DATABASE_URL=

# Turso Auth Token (from your Turso dashboard)
TURSO_AUTH_TOKEN=

# Alternative: Use DATABASE_URL instead of TURSO_DATABASE_URL
# DATABASE_URL=

# Note: If no database is configured, the app will use in-memory storage
# which resets on each deployment (good for testing, not for production)
